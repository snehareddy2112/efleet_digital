# ==========================================
# OLECTRA E-FLEET DIGITAL TWIN - ENVIRONMENT
# ==========================================

# Backend API Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*

# Time-Series Database
SQLITE_DB_PATH=telemetry.db
# DATABASE_URL=postgresql://user:password@host:5432/olectra_telemetry

# MQTT / EMQX Broker Configuration
# For local simulation: localhost / 1883
# For production cloud deployment: set your cluster broker URL & TLS credentials
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_USE_EMBEDDED=true

# EMQX Dashboard Console URL
EMQX_DASHBOARD_URL=http://localhost:18083
