# ==========================================
# OLECTRA E-FLEET FRONTEND ENVIRONMENT CONFIG
# ==========================================

# Production Backend Base URL (leave empty for local dev proxy)
# Example: https://olectra-backend.onrender.com
VITE_BACKEND_URL=

# Production WebSocket URL (leave empty for local dev proxy)
# Example: wss://olectra-backend.onrender.com/ws/telemetry
VITE_WS_URL=
